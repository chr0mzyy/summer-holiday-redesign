<?php
/**
 * Summer Holiday — przykład integracji VCMS/VIBE gate.
 *
 * WYMAGA oficjalnych plików od MerlinX oraz danych z panelu VCMS.
 * Nie publikuj identyfikatora afiliatu w repozytorium publicznym.
 */

require_once __DIR__ . '/rwdGate.php';

$affiliateId = getenv('VCMS_AFFILIATE_ID');
if (!$affiliateId) {
    http_response_code(503);
    exit('Brak konfiguracji VCMS_AFFILIATE_ID.');
}

$rwdgate = new rwdGate($affiliateId);

// Zastąp wyłącznie identyfikatorami odczytanymi z panelu VCMS.
$widgets = [
    /* SEARCH_WIDGET_ID, */
    /* PROMO_WIDGET_ID, */
    'quicksearch',
];

$rwdgate->fetch($widgets);

// Wymagane przez oficjalny gate przed wysłaniem jakiegokolwiek HTML.
if ($rwdgate->isRawResult()) {
    $rwdgate->printRawResult();
    exit;
}

$sections = $rwdgate->getSectionsList();
?>
<!doctype html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Summer Holiday — wakacje szyte na miarę</title>
    <?php echo $rwdgate->getSection('HEAD'); ?>
    <link rel="stylesheet" href="/summer-holiday-vcms.css">
</head>
<body class="sh-vcms">
    <header class="sh-header">
        <a class="sh-brand" href="/" aria-label="Summer Holiday — strona główna">
            <img src="/assets/summer-holiday-logo-transparent.webp" width="1075" height="635" alt="Summer Holiday — Biuro Podróży">
        </a>
        <nav aria-label="Nawigacja główna">
            <a href="/">Oferty</a>
            <a href="/contact">Kontakt</a>
            <a class="sh-phone" href="tel:+48572219872">572 219 872</a>
        </nav>
    </header>

    <main class="sh-main">
        <?php foreach ($widgets as $widgetId): ?>
            <?php if ($widgetId !== 'quicksearch' && in_array((string) $widgetId, $sections, true)): ?>
                <section class="sh-widget sh-widget--<?php echo htmlspecialchars((string) $widgetId, ENT_QUOTES, 'UTF-8'); ?>">
                    <?php echo $rwdgate->getSection((string) $widgetId); ?>
                </section>
            <?php endif; ?>
        <?php endforeach; ?>

        <?php if (in_array('BODY', $sections, true)): ?>
            <section class="sh-vcms-flow" aria-label="Wyniki i rezerwacja">
                <?php echo $rwdgate->getSection('BODY'); ?>
            </section>
        <?php endif; ?>
    </main>

    <?php echo $rwdgate->getSection('FOOTER'); ?>
</body>
</html>
